#!/bin/bash
set -euo pipefail
export AWS_DEFAULT_REGION=us-west-1

artifact_uri=$1
temporary=/opt/minecraft/mods/ai-god.jar.new
umask 077
environment_file=$(mktemp /etc/minecraft-ai-god.env.XXXXXX)
trap 'rm -f "$temporary" "$environment_file"' EXIT

# Older installs had a daily backup timer that restarted the whole server.
systemctl disable --now minecraft-backup.timer 2>/dev/null || true

aws s3 cp "$artifact_uri" "$temporary"
chown minecraft:minecraft "$temporary"
api_key=$(aws ssm get-parameter \
  --name /minecraft-ai-god/openai-api-key \
  --with-decryption \
  --query Parameter.Value \
  --output text)
admin_password=$(aws ssm get-parameter \
  --name /minecraft-ai-god/admin-password \
  --with-decryption \
  --query Parameter.Value \
  --output text 2>/dev/null || true)
{
  printf 'OPENAI_API_KEY=%s\n' "$api_key"
  if [[ -n "$admin_password" ]]; then
    printf 'AI_GOD_ADMIN_PASSWORD=%s\n' "$admin_password"
  fi
} > "$environment_file"

trap 'rm -f "$temporary" "$environment_file"; systemctl start minecraft' EXIT
systemctl stop minecraft || true
mv "$temporary" /opt/minecraft/mods/ai-god.jar
mv "$environment_file" /etc/minecraft-ai-god.env

systemctl start minecraft
for ((attempt = 0; attempt < 45; attempt++)); do
  if ss -ltn 'sport = :25565' | grep -q LISTEN; then
    trap - EXIT
    exit 0
  fi
  sleep 1
done
echo "Minecraft did not listen on port 25565 within 45 seconds" >&2
exit 1
